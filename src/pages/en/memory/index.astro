---
import Base from '../../../layouts/Base.astro';
import data from '../../../data/memoire.json';
const years = [2010, 2011, 2012, 2013, 2014];
const total = data.reduce((a, c) => a + c.photos.length, 0);
const cover = { 2010: 'aaz-005.jpg', 2011: 'aaz-025.jpg', 2012: 'aaz-085.jpg', 2013: 'aaz-149.jpg', 2014: 'aaz-322.jpg' };
---
<Base title="The memory" current="/en/memory/" lang="en" alt="/memoire/" description={`The complete memory of L'AgorA: ${total} dated photos, from July 2010 to October 2014, in 26 chapters, with the texts of the events.`}>
  <p class="eyebrow">The memory</p>
  <h1>L'AgorA, from the first day to the last</h1>
  <p class="lede">The page's whole album "L'Ag0rA de A @ Z", {total} photos taken between July 31, 2010 and October 16, 2014, put back in order and into chapters: the bunker emptied by wheelbarrow, the cabins, the party nights, the winters by the wood stove, the page's thirteen events with the words of the time, all the way to the big clear-out of fall 2014.</p>
  <p>A lot of people passed through, for a night or a season. If you recognize yourself, if you have your own photos or a memory to tell, write to <a href="https://www.facebook.com/lAg0rA">L'AgorA's page</a>: the memory is open. And if a photo concerns you and you'd rather it not be here, say so and it will be removed.</p>
  {years.map((y) => {
    const chs = data.filter((c) => c.year === y);
    const n = chs.reduce((a, c) => a + c.photos.length, 0);
    return (
      <section class="mem-year-card">
        <a class="mem-year-img" href={`/en/memory/${y}/`}><img src={`/memoire/t/${cover[y]}`} alt={`L'AgorA in ${y}`} loading="lazy" /></a>
        <div>
          <h2><a href={`/en/memory/${y}/`}>{y}</a> <small>{n} photos</small></h2>
          <ul>
            {chs.map((c) => <li><a href={`/en/memory/${y}/#${c.id}`}>{c.en}</a> <small>({c.photos.length})</small></li>)}
          </ul>
        </div>
      </section>
    );
  })}
  <style>
    .mem-year-card { display: grid; grid-template-columns: minmax(0, 260px) 1fr; gap: 1.4rem; align-items: start; margin: 2.2rem 0; padding-top: 1.6rem; border-top: 1px dashed var(--rope); }
    .mem-year-img img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; border: 1px dashed var(--rope); display: block; }
    .mem-year-card h2 { font-family: var(--display); font-weight: 400; font-size: 2.2rem; margin: 0 0 .4rem; }
    .mem-year-card h2 a { color: var(--sun); text-decoration: none; }
    .mem-year-card small { font-family: var(--script); font-size: 1.05rem; color: var(--ink-ornament); }
    .mem-year-card ul { margin: 0; padding-left: 1.1rem; line-height: 1.8; }
    @media (max-width: 640px) { .mem-year-card { grid-template-columns: 1fr; } }
  </style>
</Base>
