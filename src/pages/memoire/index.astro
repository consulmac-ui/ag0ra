---
import Base from '../../layouts/Base.astro';
import data from '../../data/memoire.json';
const years = [2010, 2011, 2012, 2013, 2014];
const total = data.reduce((a, c) => a + c.photos.length, 0);
const cover = { 2010: 'aaz-005.jpg', 2011: 'aaz-025.jpg', 2012: 'aaz-085.jpg', 2013: 'aaz-149.jpg', 2014: 'aaz-322.jpg' };
---
<Base title="La mémoire" current="/memoire/" alt="/en/memory/" description={`La mémoire intégrale de L'AgorA : ${total} photos datées, de juillet 2010 à octobre 2014, en 27 chapitres, avec les textes des événements.`}>
  <p class="eyebrow">La mémoire</p>
  <h1>L'AgorA, du premier jour au dernier</h1>
  <p class="lede">Les albums de la page, {total} photos, de l'album « L'Ag0rA de A @ Z » (du 31 juillet 2010 au 16 octobre 2014) aux photos de couverture et aux champignons, remises dans l'ordre et en chapitres : le bunker vidé à la brouette, les cabanes, les soirs de fête, les hivers au poêle à bois, les treize événements de la page avec leurs mots d'époque, jusqu'au grand vidage de l'automne 2014.</p>
  <p>Beaucoup de monde est passé par là, une nuit ou une saison. Si vous vous reconnaissez, si vous avez vos propres photos ou un souvenir à raconter, écrivez à la <a href="https://www.facebook.com/lAg0rA">page de L'AgorA</a> ou à info@consulmac.com : la mémoire est ouverte. Et si une photo vous concerne et que vous préférez qu'elle n'y soit pas, dites-le, elle sera retirée.</p>
  {years.map((y) => {
    const chs = data.filter((c) => c.year === y);
    const n = chs.reduce((a, c) => a + c.photos.length, 0);
    return (
      <section class="mem-year-card">
        <a class="mem-year-img" href={`/memoire/${y}/`}><img src={`/memoire/t/${cover[y]}`} alt={`L'AgorA en ${y}`} loading="lazy" /></a>
        <div>
          <h2><a href={`/memoire/${y}/`}>{y}</a> <small>{n} photos</small></h2>
          <ul>
            {chs.map((c) => <li><a href={`/memoire/${y}/#${c.id}`}>{c.fr}</a> <small>({c.photos.length})</small></li>)}
          </ul>
        </div>
      </section>
    );
  })}
  <style>
    .mem-year-card { display: grid; grid-template-columns: minmax(0, 260px) 1fr; gap: 1.4rem; align-items: start; margin: 2.2rem 0; padding-top: 1.6rem; border-top: 1px dashed var(--rope); }
    .mem-year-img img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; border: 1px dashed var(--rope); display: block; }
    .mem-year-card h2 { font-family: var(--display); font-weight: 400; font-size: 2.2rem; margin: 0 0 .4rem; }
    .mem-year-card h2 a { color: var(--sun); text-decoration: none; }
    .mem-year-card small { font-family: var(--script); font-size: 1.05rem; color: var(--ink-ornament); }
    .mem-year-card ul { margin: 0; padding-left: 1.1rem; line-height: 1.8; }
    @media (max-width: 640px) { .mem-year-card { grid-template-columns: 1fr; } }
  </style>
</Base>
